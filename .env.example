# ── Supabase ─────────────────────────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# 공개(anon / publishable) 키 — 브라우저에 노출되어도 되는 키. 권한은 RLS 정책이 제한합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── 사이트 주소 ──────────────────────────────────────────────────────────
# 실제 도메인 연결 전 임시 주소(예: https://bs-cars.vercel.app).
# 실제 공개 도메인은 관리자 페이지 → 사업 설정 → "웹사이트 도메인"에 등록합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 서버 전용 (절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요) ─────────────────
# 관리자 계정 생성 스크립트(npm run admin:create)에서만 사용합니다.
# Vercel 환경 변수에는 등록하지 않아도 됩니다.
SUPABASE_SERVICE_ROLE_KEY=
